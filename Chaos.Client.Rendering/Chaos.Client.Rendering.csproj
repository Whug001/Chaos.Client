<Project Sdk="Microsoft.NET.Sdk">
    <ItemGroup>
        <InternalsVisibleTo Include="Chaos.Client.Tests" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\Chaos.Client.Data\Chaos.Client.Data.csproj"/>
        <ProjectReference Include="$(UnoraServerPath)\Chaos.DarkAges\Chaos.DarkAges.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="MonoGame.Framework.DesktopGL"/>
    </ItemGroup>

    <ItemGroup>
        <!-- Haunted-mirror scare creatures, drawn by Tools/MirrorScare/draw_creatures.py. Embedded so they ship with the
             client and need no .dat patch; read back by MirrorScareRenderer as "mirrorscare.<file>". -->
        <EmbeddedResource Include="Assets\MirrorScare\*.png">
            <LogicalName>mirrorscare.%(Filename)%(Extension)</LogicalName>
        </EmbeddedResource>

        <!-- Josephine's Mirror backdrops, cut from real maps by Tools/MirrorBackdrops. Embedded so every player has
             them, whichever maps they have visited; read back by MirrorBackdropAssets as "mirrorbackdrop.<file>". -->
        <EmbeddedResource Include="Assets\MirrorBackdrops\*.png">
            <LogicalName>mirrorbackdrop.%(Filename)%(Extension)</LogicalName>
        </EmbeddedResource>

        <!-- Pumpkin Carving face map, written by Unora Tools/PumpkinCarving/make_pumpkin.py with the sprite it matches.
             Read back by PumpkinFaceMap as "pumpkin.facemap.json". -->
        <EmbeddedResource Include="Assets\Pumpkin\pumpkinfacemap.json">
            <LogicalName>pumpkin.facemap.json</LogicalName>
        </EmbeddedResource>

        <!-- Tumble Tower ooze frames, made by Unora Tools/TumbleTower/art. Missing files fall back to drawn placeholders
             in TumbleOozeFrames; read back as "tumbleooze.<file>". -->
        <EmbeddedResource Include="Assets\TumbleOoze\*.png">
            <LogicalName>tumbleooze.%(Filename)%(Extension)</LogicalName>
        </EmbeddedResource>

        <!-- Drowned Causeway river art, made by Unora Tools/DrownedCauseway/art. Missing files fall back to drawn
             placeholders in CausewayFrames; read back as "causeway.<file>". -->
        <EmbeddedResource Include="Assets\Causeway\*.png">
            <LogicalName>causeway.%(Filename)%(Extension)</LogicalName>
        </EmbeddedResource>

        <!-- The Glass Way overlay art (rune, mark, safe tint, hole, shards); read back by GlassWayFrames as "glassway.<file>". -->
        <EmbeddedResource Include="Assets\GlassWay\*.png">
            <LogicalName>glassway.%(Filename)%(Extension)</LogicalName>
        </EmbeddedResource>

        <!-- Loures Cinema seated view (backdrop, curtains, seat back), made by Unora Tools/Cinema/art/draw_seated.py;
             read back as "cinema.<file>". -->
        <EmbeddedResource Include="Assets\Cinema\*.png">
            <LogicalName>cinema.%(Filename)%(Extension)</LogicalName>
        </EmbeddedResource>

        <!-- Chat bubble frames (21 x 21, 3 x 3 cells of 7 px), drawn by Unora Tools/ChatBubbles/draw_frames.py;
             read back by ChatBubbleFrames as "bubbleframe.<n>.png". -->
        <EmbeddedResource Include="Assets\BubbleFrames\*.png">
            <LogicalName>bubbleframe.%(Filename)%(Extension)</LogicalName>
        </EmbeddedResource>
    </ItemGroup>
    <ItemGroup>
        <!-- Guild hall editor glyphs, white-on-transparent 12px icons; read back by GuildHallIconAssets as "guildhallicon.<file>". -->
        <EmbeddedResource Include="Assets\GuildHallIcons\*.png">
            <LogicalName>guildhallicon.%(Filename)%(Extension)</LogicalName>
        </EmbeddedResource>
    </ItemGroup>
</Project>